[Unit]
Description=EZPlayer phone setup portal
After=ezplayer-pi.service
Requires=ezplayer-pi.service

[Service]
Type=simple
User=ezplayer-portal
Group=ezplayer-system
ExecStart=/usr/bin/python3 /usr/local/lib/ezplayer-pi/setup_portal.py
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET
UMask=0077

[Install]
WantedBy=multi-user.target
