[Unit]
Description=EZPlayer restricted hotspot HTTPS gateway
Requires=ezplayer-network.service
After=ezplayer-network.service
PartOf=ezplayer-network.service

[Service]
Type=simple
RuntimeDirectory=ezplayer-gateway
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/python3 /opt/ezplayer-network/hotspot_gateway.py prepare
ExecStart=/usr/sbin/nginx -c /etc/ezplayer-gateway.conf -g "daemon off;"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
