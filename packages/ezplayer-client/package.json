{
    "name": "@ezplayer/ezplayer-client",
    "private": true,
    "version": "0.1.0",
    "description": "Pure-Node client for a running EZPlayer's web API: player commands, playback statistics, and measured playback runs. No electron.",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "default": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsup",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "test": "vitest",
        "format": "prettier --write ./src",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "@ezplayer/ezplayer-core": "workspace:*"
    },
    "devDependencies": {
        "eslint": "catalog:",
        "rimraf": "^6.1.3",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "vitest": "catalog:"
    }
}
