{
    "name": "@ezplayer/xlgl",
    "private": true,
    "version": "0.1.0",
    "description": "In-process offscreen GL 3.3 core context (WGL / EGL, or Mesa llvmpipe) as a Node-API addon, for GPU-evaluated overlay patterns.",
    "license": "AGPL-3.0-only",
    "type": "module",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src/xlgl.cpp",
        "src/glcore.h",
        "binding.gyp",
        "build/Release/*.node"
    ],
    "scripts": {
        "install": "node-gyp rebuild",
        "build": "tsup src/index.ts --dts --format esm --out-dir dist",
        "rebuild": "node-gyp rebuild",
        "test": "vitest run",
        "clean": "rimraf dist build"
    },
    "dependencies": {
        "bindings": "^1.5.0",
        "node-addon-api": "^8.9.2"
    },
    "devDependencies": {
        "node-gyp": "^13.1.0",
        "rimraf": "^6.1.3",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
