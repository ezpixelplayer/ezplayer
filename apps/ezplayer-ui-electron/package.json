{
    "name": "ezplayer-ui-electron",
    "author": {
        "name": "EZPlayer",
        "email": "ezplayer@ezrgb.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ezpixelplayer/ezplayer.git"
    },
    "private": true,
    "license": "AGPL-3.0",
    "version": "0.6.12",
    "main": "dist/main.js",
    "type": "module",
    "build": {
        "appId": "dev.ezplayer.ezplayer",
        "productName": "EZPlayer",
        "directories": {
            "output": "release",
            "buildResources": "assets"
        },
        "files": [
            "dist/**/*",
            "package.json",
            "build/Release/*.node",
            "node_modules/@ezplayer/icmp-ping/dist/**/*",
            "node_modules/@ezplayer/icmp-ping/package.json",
            "node_modules/@ezplayer/icmp-ping/build/Release/*.node",
            "node_modules/@lydell/node-pty/**/*",
            "node_modules/@lydell/node-pty-*/**/*",
            "node_modules/ffmpeg-static/**/*",
            "node_modules/mpg123-decoder-ezp/**/*",
            "node_modules/@wasm-audio-decoders/common/**/*",
            "node_modules/opusscript/**/*"
        ],
        "asarUnpack": [
            "**/*.node",
            "**/ffmpeg-static/**"
        ],
        "extraResources": [
            {
                "from": "src/assets/images",
                "to": "images",
                "filter": [
                    "EZPlayerLogoTransparent.ico",
                    "EZPlayerLogoTransparent.png",
                    "EZPlayerLogoTransparent.icns"
                ]
            },
            {
                "from": "../ezplayer-ui-embedded/dist",
                "to": "webapp",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "src/assets/images/EZPlayerLogoTransparent.ico",
            "artifactName": "${productName}-Setup-${version}.${ext}",
            "extraFiles": [
                {
                    "from": "bin/ezplayer.cmd",
                    "to": "ezplayer.cmd"
                }
            ]
        },
        "mac": {
            "artifactName": "${productName}-${version}-${arch}.${ext}",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "assets/entitlements.mac.plist",
            "entitlementsInherit": "assets/entitlements.mac.plist",
            "notarize": true,
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "icon": "src/assets/images/EZPlayerLogoTransparent.icns"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb",
                "tar.gz"
            ],
            "executableArgs": [
                "--no-sandbox"
            ],
            "icon": "src/assets/images/EZPlayerLogoTransparent.png",
            "category": "Utility"
        },
        "publish": [
            {
                "provider": "github",
                "releaseType": "prerelease"
            }
        ]
    },
    "scripts": {
        "start": "pnpm dev",
        "dev": "node scripts/dev-with-port.mjs",
        "dev:direct": "pnpm --filter @ezplayer/ui-embedded build:web && concurrently \"pnpm --filter @ezplayer/ui-embedded build:web:watch\" \"pnpm dev:react\" \"pnpm dev:electron\"",
        "dev:react": "vite --config vite.config.ts",
        "dev:electron": "pnpm build:tsc && pnpm build:preload && electron .",
        "build": "pnpm --filter @ezplayer/ui-embedded build && pnpm --filter @ezplayer/ui-embedded build:web && node-gyp rebuild && pnpm build:react && pnpm build:tsc && pnpm build:preload && electron-builder --publish never && pnpm audit:deps",
        "audit:deps": "node scripts/depaudit.cjs",
        "build:react": "vite build --config vite.config.ts",
        "build:tsc": "tsc --noEmit && node scripts/build-main.mjs",
        "build:main": "node scripts/build-main.mjs",
        "build:preload": "tsc -p tsconfig.preload.json",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "test": "vitest run",
        "test:watch": "vitest",
        "prod": "sh -c './release/win-unpacked/EZPlayer.exe'",
        "prod:nodetrace": "sh -c 'export NODE_OPTIONS=\"--trace-opt --trace-deopt --trace-turbo-inlining\" && .\\release\\win-unpacked\\EZPlayer.exe --enable-logging --v=1'",
        "prod:log": "sh -c './release/win-unpacked/EZPlayer.exe --enable-logging --v=1'",
        "prod:sf": "sh -c './release/win-unpacked/EZPlayer.exe --show-folder=THIS_IS_AN_EXAMPLE'"
    },
    "comment:electron-builder": "Pinned at 26.16.0. 26.18.0 fixed its pnpm dependency collector and now packs every workspace package's transitive deps into app.asar, including devDependencies (sass, chokidar) and renderer-only libs Vite already inlined (vis-timeline, three, hls.js): asar 227 MB -> 470 MB, installer 187 MB -> 215 MB. Revisit with a files/exclude list before unpinning.",
    "comment:optionalDependencies": "node-pty's prebuilt binaries, one package per platform/arch. Listed explicitly because pnpm 10+ does not auto-install TRANSITIVE platform binaries, so without these a mac/linux/arm build would package an app whose shell silently fails to load. Keep the versions in lockstep with @lydell/node-pty.",
    "optionalDependencies": {
        "@lydell/node-pty-darwin-arm64": "1.2.0-beta.18",
        "@lydell/node-pty-darwin-x64": "1.2.0-beta.18",
        "@lydell/node-pty-linux-arm64": "1.2.0-beta.18",
        "@lydell/node-pty-linux-x64": "1.2.0-beta.18",
        "@lydell/node-pty-win32-arm64": "1.2.0-beta.18",
        "@lydell/node-pty-win32-x64": "1.2.0-beta.18"
    },
    "devDependencies": {
        "@electron/asar": "^4.3.1",
        "@types/koa": "catalog:",
        "@types/koa-static": "catalog:",
        "@types/node": "catalog:",
        "@types/proper-lockfile": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "concurrently": "^10.0.6",
        "dmg-builder": "26.16.0",
        "electron": "^44.10.1",
        "electron-builder": "26.16.0",
        "electron-builder-squirrel-windows": "26.16.0",
        "esbuild": "catalog:",
        "node-gyp": "^13.1.0",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vite-plugin-static-copy": "^3.4.0",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@ezplayer/epp": "workspace:*",
        "@ezplayer/epp-controllers": "file:..\\..\\libs\\ezplayer-epp-controllers-0.0.37.tgz",
        "@ezplayer/ezplayer-client": "workspace:*",
        "@ezplayer/ezplayer-core": "workspace:*",
        "@ezplayer/icmp-ping": "workspace:*",
        "@ezplayer/player-ui-components": "workspace:*",
        "@ezplayer/shared-ui-components": "workspace:*",
        "@ezplayer/ui-embedded": "workspace:*",
        "@floating-ui/core": "^1.8.0",
        "@floating-ui/react": "^0.27.20",
        "@koa/router": "^15.7.0",
        "@koa/send": "^6.0.0",
        "@lydell/node-pty": "1.2.0-beta.18",
        "@mui/icons-material": "catalog:",
        "@mui/material": "catalog:",
        "@mui/styles": "catalog:",
        "@mui/x-date-pickers": "catalog:",
        "@reduxjs/toolkit": "catalog:",
        "@types/ws": "catalog:",
        "@wasm-audio-decoders/common": "9.0.7",
        "audiofile": "file:..\\..\\libs\\audiofile-0.0.5.tgz",
        "axios": "catalog:",
        "bindings": "^1.5.0",
        "crc-32": "^1.2.2",
        "debug": "^4.4.3",
        "electron-store": "^12.0.0",
        "electron-updater": "^6.8.11",
        "ffmpeg-static": "^5.3.0",
        "i18next": "catalog:",
        "jszip": "catalog:",
        "koa": "^3.2.1",
        "koa-static": "^5.0.0",
        "mpg123-decoder-ezp": "file:..\\..\\libs\\mpg123-decoder-ezp-1.0.4.tgz",
        "node-addon-api": "^8.9.2",
        "nprogress": "catalog:",
        "opusscript": "^0.1.1",
        "path": "^0.12.7",
        "proper-lockfile": "^4.1.2",
        "raw-body": "^4.0.0",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-helmet-async": "catalog:",
        "react-i18next": "catalog:",
        "react-redux": "catalog:",
        "react-router": "catalog:",
        "react-router-dom": "catalog:",
        "react-toastify": "catalog:",
        "uuid": "catalog:",
        "ws": "^8.22.0",
        "xllayoutcalcs": "file:..\\..\\libs\\xllayoutcalcs-0.4.1.tgz",
        "zstd-codec": "^0.1.5",
        "zstddec": "^0.3.4"
    }
}
